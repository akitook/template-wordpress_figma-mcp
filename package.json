{
  "name": "template-wordpress-wordmove",
  "version": "1.0.0",
  "author": "FURAZOA",
  "license": "GPL-2.0-or-later",
  "packageManager": "npm@10.2.4",
  "dependencies": {
    "gsap": "^3.12.4",
    "jquery": "^3.7.1",
    "prettier": "^3.2.2",
    "throttle-debounce": "^5.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow npm",
    "theme-json": "node scripts/theme-json.js",
    "vite:watch": "vite build --watch --mode development",
    "scss:watch": "node scripts/scss.js --watch",
    "copy:watch": "node scripts/copy.js --watch",
    "browser:watch": "browser-sync start --config bs-config.js",
    "vite:production": "vite build",
    "scss:production": "node scripts/scss.js --production",
    "copy:production": "node scripts/copy.js --production",
    "watch": "npm-run-all -p *:watch",
    "build": "npm-run-all -p *:production",
    "clean": "rimraf ./public",
    "login:wordmove": "docker exec -w /home/wordmove -it [.envで設定したPROJECT_NAME]_wordmove /bin/bash",
    "docker-rebuild": "docker compose build --no-cache",
    "prestart": "docker stop $(docker ps -q) || true && docker compose up -d",
    "start": "npm run watch",
    "stop": "docker compose stop"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "autoprefixer": "^10.4.0",
    "browser-sync": "^3.0.2",
    "cpx2": "^2.0.0",
    "dotenv": "^16.4.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "fs-extra": "^11.2.0",
    "globals": "^15.0.0",
    "npm-run-all": "^4.1.5",
    "postcss-custom-media": "^10.0.2",
    "postcss-sorting": "^8.0.2",
    "ress": "^5.0.2",
    "rimraf": "^5.0.0",
    "sass": "^1.69.7",
    "stylelint": "^16.1.0",
    "stylelint-config-recess-order": "^4.4.0",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-config-standard-scss": "^13.0.0",
    "stylelint-order": "^6.0.4",
    "vite": "^6.0.0"
  }
}
