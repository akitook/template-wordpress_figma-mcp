{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "color": {
      "custom": false,
      "customGradient": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "defaultDuotone": false,
      "palette": [
        {
          "slug": "gray-0",
          "name": "Gray 0",
          "color": "#ffffff"
        },
        {
          "slug": "gray-50",
          "name": "Gray 50",
          "color": "#f9f9f9"
        },
        {
          "slug": "gray-200",
          "name": "Gray 200",
          "color": "#dddddd"
        },
        {
          "slug": "gray-400",
          "name": "Gray 400",
          "color": "#999999"
        },
        {
          "slug": "gray-600",
          "name": "Gray 600",
          "color": "#666666"
        },
        {
          "slug": "gray-800",
          "name": "Gray 800",
          "color": "#333333"
        },
        {
          "slug": "gray-900",
          "name": "Gray 900",
          "color": "#222222"
        }
      ]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "dropCap": false,
      "fluid": {
        "minViewportWidth": "375px",
        "maxViewportWidth": "1920px"
      },
      "fontFamilies": [
        {
          "slug": "serif",
          "name": "Serif",
          "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", yumincho, serif"
        },
        {
          "slug": "sans",
          "name": "Sans",
          "fontFamily": "\"Noto Sans JP\", \"Hiragino Kaku Gothic ProN\", \"ヒラギノ角ゴ ProN W3\", meiryo, メイリオ, sans-serif"
        },
        {
          "slug": "sans-en",
          "name": "Sans English",
          "fontFamily": "\"Afacad Flux\", sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "caption",
          "name": "Caption",
          "size": "14px",
          "fluid": {
            "min": "10px",
            "max": "14px"
          }
        },
        {
          "slug": "caption-fixed",
          "name": "Caption Fixed",
          "size": "14px",
          "fluid": false
        },
        {
          "slug": "body",
          "name": "Body",
          "size": "16px",
          "fluid": {
            "min": "14px",
            "max": "16px"
          }
        },
        {
          "slug": "title-medium",
          "name": "Title Medium",
          "size": "20px",
          "fluid": false
        },
        {
          "slug": "title-large",
          "name": "Title Large",
          "size": "24px",
          "fluid": {
            "min": "20px",
            "max": "24px"
          }
        }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "units": ["px", "%", "em", "rem", "vw", "vh"],
      "spacingSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "16px"
        },
        {
          "slug": "medium",
          "name": "Medium",
          "size": "32px"
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "64px"
        },
        {
          "slug": "x-large",
          "name": "Extra Large",
          "size": "96px"
        }
      ]
    },
    "layout": {
      "contentSize": "880px",
      "wideSize": "1280px"
    },
    "custom": {
      "textStyles": {
        "title-large": {
          "fontFamily": "serif",
          "fontSize": "title-large",
          "fontWeight": "300",
          "lineHeight": "2",
          "letterSpacing": "0.2em"
        },
        "title-medium": {
          "fontFamily": "serif",
          "fontSize": "title-medium",
          "fontWeight": "300",
          "lineHeight": "2",
          "letterSpacing": "0.1em"
        },
        "body-large": {
          "fontFamily": "serif",
          "fontSize": "body",
          "fontWeight": "300",
          "lineHeight": "2.4",
          "letterSpacing": "0.1em"
        },
        "body-light": {
          "fontFamily": "serif",
          "fontSize": "body",
          "fontWeight": "300",
          "lineHeight": {
            "sp": "1.6",
            "pc": "1.8"
          },
          "letterSpacing": "0.1em"
        },
        "caption-medium": {
          "fontFamily": "serif",
          "fontSize": "caption",
          "fontWeight": "300",
          "lineHeight": {
            "sp": "2",
            "pc": "1.8"
          },
          "letterSpacing": "0.1em"
        },
        "button": {
          "fontFamily": "serif",
          "fontSize": "body",
          "fontWeight": "500",
          "lineHeight": "2",
          "letterSpacing": "0.1em"
        },
        "button-medium": {
          "fontFamily": "serif",
          "fontSize": "caption-fixed",
          "fontWeight": "500",
          "lineHeight": "1.8",
          "letterSpacing": "0.1em"
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--gray-0)",
      "text": "var(--wp--preset--color--gray-900)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--serif)",
      "fontSize": "var(--wp--preset--font-size--body)",
      "fontWeight": "300",
      "letterSpacing": "0.1em",
      "lineHeight": "1.8"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--gray-900)"
        },
        "typography": {
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--gray-900)"
          },
          "typography": {
            "textDecoration": "none"
          }
        }
      }
    }
  }
}
