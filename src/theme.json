{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "color": {
      "custom": false,
      "customGradient": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "defaultDuotone": false,
      "palette": [
        { "slug": "white", "name": "White", "color": "#fff" },
        { "slug": "black", "name": "Black", "color": "#000" },
        { "slug": "gray", "name": "Gray", "color": "#657786" },
        { "slug": "gray-light", "name": "Gray Light", "color": "#e1e8ed" },
        {
          "slug": "gray-ultralight",
          "name": "Gray Ultralight",
          "color": "#f7f7f7"
        },
        { "slug": "pink", "name": "Pink", "color": "#ed3e73" },
        { "slug": "red", "name": "Red", "color": "#f25f6d" },
        { "slug": "yellow", "name": "Yellow", "color": "#fad508" },
        { "slug": "orange", "name": "Orange", "color": "#f7a61e" },
        { "slug": "primary", "name": "Primary", "color": "#0016ff" },
        { "slug": "primary-dark", "name": "Primary Dark", "color": "#0016ff" },
        {
          "slug": "primary-light",
          "name": "Primary Light",
          "color": "#4051ff"
        },
        {
          "slug": "primary-ultralight",
          "name": "Primary Ultralight",
          "color": "#f8fafe"
        },
        {
          "slug": "primary-background",
          "name": "Primary Background",
          "color": "#f0f1f7"
        }
      ]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "dropCap": false,
      "fluid": {
        "minViewportWidth": "375px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Sans",
          "fontFamily": "\"Noto Sans JP\", \"Hiragino Kaku Gothic ProN\", \"ヒラギノ角ゴ ProN W3\", meiryo, メイリオ, sans-serif"
        },
        {
          "slug": "serif",
          "name": "Serif",
          "fontFamily": "georgia, 游明朝, \"Yu Mincho\", yumincho, \"Hiragino Mincho ProN\", hgs明朝e, メイリオ, meiryo, serif"
        },
        {
          "slug": "sans-en",
          "name": "Sans English",
          "fontFamily": "\"Montserrat\", sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "12px", "fluid": false },
        { "slug": "medium", "name": "Medium", "size": "14px", "fluid": false },
        {
          "slug": "large",
          "name": "Large",
          "size": "20px",
          "fluid": { "min": "16px", "max": "20px" }
        },
        {
          "slug": "x-large",
          "name": "Extra Large",
          "size": "28px",
          "fluid": { "min": "22px", "max": "28px" }
        },
        {
          "slug": "xx-large",
          "name": "Extra Extra Large",
          "size": "40px",
          "fluid": { "min": "28px", "max": "40px" }
        }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "units": ["px", "%", "em", "rem", "vw", "vh"],
      "spacingSizes": [
        { "slug": "small", "name": "Small", "size": "16px" },
        { "slug": "medium", "name": "Medium", "size": "32px" },
        { "slug": "large", "name": "Large", "size": "64px" },
        { "slug": "x-large", "name": "Extra Large", "size": "96px" }
      ]
    },
    "layout": {
      "contentSize": "880px",
      "wideSize": "1280px"
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--black)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.5"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--black)" },
        "typography": { "textDecoration": "none" },
        ":hover": {
          "color": { "text": "var(--wp--preset--color--black)" },
          "typography": { "textDecoration": "none" }
        }
      }
    }
  }
}
